{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myomars.local/contracts/v1/envelope.schema.json",
  "title": "envelope",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "myomars/v1"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "retestId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "sentAt": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "trigger",
        "hud",
        "station"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "scenario.start",
        "scenario.reset",
        "observation.submitted",
        "hud.received",
        "hud.ack",
        "hud.defer",
        "retest.completed",
        "retest.result",
        "station.notice.approved",
        "station.retest.requested",
        "station.receipt",
        "station.reassessment",
        "station.audit.assessment",
        "station.audit.review",
        "station.eva.ended"
      ]
    },
    "payload": {}
  },
  "required": [
    "schema",
    "eventId",
    "sessionId",
    "runId",
    "caseId",
    "sentAt",
    "source",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
