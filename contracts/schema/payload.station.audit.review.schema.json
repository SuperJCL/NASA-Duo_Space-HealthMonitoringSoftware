{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myomars.local/contracts/v1/payload.station.audit.review.schema.json",
  "title": "payload.station.audit.review",
  "type": "object",
  "properties": {
    "evaluationVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "hold",
        "close",
        "keep-open"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "decidedAt": {
      "type": "string"
    },
    "caseStatus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "dispatchedEventIds": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "evaluationVersion",
    "decision",
    "reason",
    "reviewer",
    "decidedAt",
    "caseStatus",
    "dispatchedEventIds"
  ],
  "additionalProperties": false
}
