{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myomars.local/contracts/v1/payload.station.notice.approved.schema.json",
  "title": "payload.station.notice.approved",
  "type": "object",
  "properties": {
    "noticeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "basis": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "evaluationVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reviewReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "simulated": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "noticeId",
    "text",
    "basis",
    "evaluationVersion",
    "reviewedBy",
    "reviewReason",
    "simulated"
  ],
  "additionalProperties": false
}
