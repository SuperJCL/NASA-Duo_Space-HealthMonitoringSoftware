{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myomars.local/contracts/v1/payload.scenario.start.schema.json",
  "title": "payload.scenario.start",
  "type": "object",
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "astronaut": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "callsign": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "id",
        "callsign"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "targetId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "scenarioId",
    "astronaut",
    "task"
  ],
  "additionalProperties": false
}
